@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>登录 - EZPannel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: linear-gradient(135deg, #134e4a, #10b981); height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 400px; padding: 40px; border-radius: 12px; background: rgba(255, 255, 255, 0.94); box-shadow: 0 10px 25px rgba(0,0,0,0.12); }
        .login-title { text-align: center; margin-bottom: 30px; color: #2f3437; font-weight: bold; }
        .btn-primary { background: linear-gradient(135deg, #059669, #34d399); border: none; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2 class="login-title">EZPannel 登录</h2>
        <div id="loginError" class="alert alert-danger py-2 small" style="display:none;"></div>
        <form id="loginForm" autocomplete="off">
            <div class="mb-3">
                <label class="form-label">用户名</label>
                <input type="text" name="username" class="form-control" required placeholder="请输入用户名">
            </div>
            <div class="mb-4">
                <label class="form-label">密码</label>
                <input type="password" name="password" class="form-control" required placeholder="请输入密码">
            </div>
            <div class="mb-4">
                <label class="form-label">验证码</label>
                <div class="input-group">
                    <input type="text" name="code" class="form-control" required placeholder="请输入验证码">
                    <img id="captchaImg" src="/Auth/Code" alt="验证码" class="img-thumbnail" style="cursor: pointer;" onclick="refreshCaptcha()">
                </div>
            </div>
            <div class="d-grid">
                <button type="submit" class="btn btn-primary">登录</button>
            </div>
        </form>
    </div>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script>
        // Clear old tokens
        localStorage.removeItem('token');
        document.cookie = "access_token=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";

        function refreshCaptcha() {
            $('#captchaImg').attr('src', '/Auth/Code?' + new Date().getTime());
        }

        $('#loginForm').on('submit', function(e) {
            e.preventDefault();

            var $form = $(this);
            if (!$form[0].checkValidity()) {
                $form[0].reportValidity();
                return;
            }

            var $btn = $form.find('button[type="submit"]');
            $btn.prop('disabled', true).text('登录中...');

            $.ajax({
                url: '/Auth/Login',
                type: 'POST',
                data: $form.serialize(),
                dataType: 'json',
                success: function(res) {
                    if (res && res.success) {
                        window.location.href = res.redirect || '/Home/Index';
                    } else {
                        $('#loginError').text((res && res.message) || '登录失败').show();
                        $btn.prop('disabled', false).text('登录');
                        $form.find('input[name="code"]').val('');
                        refreshCaptcha();
                    }
                },
                error: function(xhr) {
                    var msg = '登录失败，请稍后重试';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        msg = xhr.responseJSON.message;
                    }
                    $('#loginError').text(msg).show();
                    $btn.prop('disabled', false).text('登录');
                    refreshCaptcha();
                }
            });
        });
    </script>
</body>
</html>